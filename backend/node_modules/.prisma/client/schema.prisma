generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. ROLES (Permisos y Perfiles del Sistema)
// -------------------------------------------------------------
model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique // "ADMIN", "USER", "MODERATOR"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  users User[]

  @@map("roles")
}

// -------------------------------------------------------------
// 2. USUARIOS (Compradores, Vendedores y Administradores)
// -------------------------------------------------------------
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  username  String   @unique
  email     String   @unique
  password  String
  avatarUrl String?
  bio       String?
  city      String?
  country   String   @default("España")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Clave foránea Role
  roleId String @db.ObjectId

  // Relaciones
  role     Role      @relation(fields: [roleId], references: [id])
  products Product[] @relation("SellerProducts")

  @@map("users")
}

// -------------------------------------------------------------
// 3. CATEGORÍAS (Jerarquía con autorreferencia)
// -------------------------------------------------------------
model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  parentId  String?  @db.ObjectId
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación reflexiva para subcategorías
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children Category[] @relation("CategoryHierarchy")

  // Relación con productos
  products Product[]

  @@map("categories")
}

// -------------------------------------------------------------
// 4. MARCAS
// -------------------------------------------------------------
model Brand {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  slug      String   @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relación con productos
  products Product[]

  @@map("brands")
}

// -------------------------------------------------------------
// 5. PRODUCTOS (Entidad Base / Catálogo Padre)
// -------------------------------------------------------------
model Product {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String    @unique
  description String
  status      String    @default("available") // "available" | "reserved" | "sold" | "hidden"
  viewsCount  Int       @default(0)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Claves foráneas
  sellerId   String @db.ObjectId
  categoryId String @db.ObjectId
  brandId    String @db.ObjectId

  // Relaciones
  seller   User             @relation("SellerProducts", fields: [sellerId], references: [id])
  category Category         @relation(fields: [categoryId], references: [id])
  brand    Brand            @relation(fields: [brandId], references: [id])
  variants ProductVariant[]

  @@index([status, isActive, createdAt(sort: Desc)])
  @@map("products")
}

// -------------------------------------------------------------
// 6. VARIANTES DE PRODUCTO (Tallas, Colores, Estado y Precios)
// -------------------------------------------------------------
model ProductVariant {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  sku       String?  @unique
  size      String // "XS", "S", "M", "L", "XL", "42", etc.
  color     String? // "Negro", "Azul denim", etc.
  condition String // "Nuevo con etiquetas", "Muy bueno", etc.
  price     Float
  stock     Int      @default(1) // En segunda mano suele ser 1
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Clave foránea a Product
  productId String @db.ObjectId

  // Relaciones
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  images  ProductImage[]

  @@index([productId, size])
  @@map("product_variants")
}

// -------------------------------------------------------------
// 7. IMÁGENES DE PRODUCTO (Colección Independiente)
// -------------------------------------------------------------
model ProductImage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  url       String
  altText   String?
  isCover   Boolean  @default(false) // Indica si es la foto principal
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  // Clave foránea a Variante
  variantId String @db.ObjectId

  // Relaciones
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, sortOrder])
  @@map("product_images")
}
